# Shared password the user types on /login to access the app.
APP_PASSWORD=change-me

# Random secret used to sign auth cookies. Generate one with:
#   openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-string

# Google Apps Script endpoint that returns the spreadsheet rows.
SHEETS_WEBAPP_URL=https://script.google.com/macros/s/.../exec

# n8n webhook URLs.
N8N_TEXT_WEBHOOK=https://your-n8n-host/webhook/socmedposting-text
N8N_IMAGE_WEBHOOK=https://your-n8n-host/webhook/socmedposting-media
N8N_PUBLISH_WEBHOOK=https://your-n8n-host/webhook/platform-publish
